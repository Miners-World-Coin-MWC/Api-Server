    "hono": "4.9.7",
    "tiny-secp256k1": "2.2.3",
    "ecpair": "3.0.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260919.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.38.0"
  }
}
