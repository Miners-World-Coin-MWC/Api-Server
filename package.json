{
  "name": "@minersworld/mwc-api-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented Miners World Coin API gateway and non-custodial browser wallet core.",
  "type": "module",
  "workspaces": ["web-wallet"],
  "scripts": {
