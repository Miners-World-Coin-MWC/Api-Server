{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minersworld-api-wallet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "api2.minersworld.org", "custom_domain": true }
  ],
  "vars": {
    "ORIGINAL_API_URL": "https://api.minersworld.org",
    "CHAIN": "mainnet",
    "CORS_ORIGIN": "*",
    "MWC_DECIMALS": "8",
    "MWC_MIN_LOCK_SECONDS": "0"
  }
}
